# 可选：Docker Compose 环境变量。敏感信息建议在 WebUI 中填写（会加密存库）。
TZ=Asia/Shanghai
# 宿主机端口映射可改为 "127.0.0.1:3155:3155" 仅本机访问
RADAR_PORT=3155

# 国内构建加速（可选）：清华 PyPI 镜像
# PIP_INDEX_URL=https://pypi.tuna.tsinghua.edu.cn/simple

# 镜像拉取加速（可选，填写可用的镜像代理地址；不要照抄，先确认你的网络能访问）
# PYTHON_IMAGE=docker.m.daocloud.io/library/python:3.12-slim
# BROWSER_IMAGE=ghcr.m.daocloud.io/browserless/chromium:latest

# 需要浏览器渲染时再启用 browser profile（默认不拉取约 1GB 的 Chromium）
# COMPOSE_PROFILES=browser
